#!/bin/zsh
# devpin - keeps the xcodebuild destination of a repository in .devpin/
setopt no_unset pipe_fail extended_glob

DEVPIN_VERSION="0.0.0"

# ---------------------------------------------------------------- messages

die()  { print -u2 -r -- "devpin: $*"; exit 1 }
warn() { print -u2 -r -- "devpin: warning: $*" }

usage_text() {
  cat <<'USAGE'
Usage: devpin [--root <dir>] <command>
  get [--slot S]                          print the destination
  show                                    every repository, slot, value and source
  list                                    available simulators and paired phones
  use [--slot S] [--only-root] <device>   write the choice into .devpin/*local
  use [--slot S] [--only-root] --reset    remove it
  init [--default <device>]               create .devpin/
  check                                   find devices written into commands
  --version
USAGE
}

usage() { usage_text >&2; exit 2 }

# ---------------------------------------------------------------- root

ROOT=""
ROOT_OPT=""

# find_root: sets ROOT, the physical absolute path of the directory holding .devpin/, or dies.
find_root() {
  if [[ -n $ROOT_OPT ]]; then
    [[ -d ${ROOT_OPT:A}/.devpin ]] || die "no .devpin/ in ${ROOT_OPT:A} (named by --root) — run devpin init"
    ROOT=${ROOT_OPT:A}
    return 0
  fi

  local start=$PWD:A top dir
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=/
  top=${top:A}

  dir=$start
  while true; do
    if [[ -d $dir/.devpin ]]; then
      ROOT=$dir
      return 0
    fi
    [[ $dir == "$top" || $dir == / ]] && break
    dir=${dir:h}
  done
  die "no .devpin/ in $start or above it, up to $top — run devpin init"
}

# ---------------------------------------------------------------- values

# read_value <file>: prints the first non-blank line, trimmed of whitespace and CR;
# returns 1 when the file is absent or holds no such line.
read_value() {
  local file=$1 line
  [[ -f $file ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line##[[:space:]]#}
    line=${line%%[[:space:]]#}
    if [[ -n $line ]]; then
      print -r -- "$line"
      return 0
    fi
  done < "$file"
  return 1
}

# env_name [slot]: the environment variable of a slot (the main slot when empty).
env_name() {
  if [[ -z ${1:-} ]]; then
    print -r -- DEVPIN_DESTINATION
  else
    local s=${(U)1}
    print -r -- "DEVPIN_DESTINATION_${s//-/_}"
  fi
}

RES_VALUE=""
RES_SOURCE=""       # env | local | default | main | missing
RES_PLACE=""        # the variable or file a person edits
RES_MAIN_SOURCE=""  # when RES_SOURCE is main: env | local | default

# resolve_own <repo> [slot]: rows 1-3 of the resolution table for one slot, no fallback.
# Sets RES_VALUE, RES_SOURCE, RES_PLACE; RES_SOURCE is missing when nothing holds a value.
resolve_own() {
  local repo=$1 slot=${2:-} var prefix=""
  [[ -n $slot ]] && prefix="$slot."

  var=$(env_name "$slot")
  if [[ -n ${(P)var:-} ]]; then
    RES_VALUE=${(P)var}; RES_SOURCE=env; RES_PLACE=$var
    return 0
  fi

  local kind
  for kind in local default; do
    if RES_VALUE=$(read_value "$repo/.devpin/$prefix$kind"); then
      RES_SOURCE=$kind; RES_PLACE="$repo/.devpin/$prefix$kind"
      return 0
    fi
  done

  RES_VALUE=""; RES_SOURCE=missing; RES_PLACE="$repo/.devpin/${prefix}default"
  return 1
}

# resolve <repo> [slot]: sets RES_VALUE, RES_SOURCE, RES_PLACE (and RES_MAIN_SOURCE on a
# fallback). Always returns 0; check RES_SOURCE for missing.
resolve() {
  local repo=$1 slot=${2:-}
  RES_MAIN_SOURCE=""
  resolve_own "$repo" "$slot" && return 0
  if [[ -n $slot ]]; then
    local missing_place=$RES_PLACE
    if resolve_own "$repo" ""; then
      RES_MAIN_SOURCE=$RES_SOURCE
      RES_SOURCE=main
      RES_PLACE="$RES_PLACE (no $slot device of its own)"
      return 0
    fi
    RES_PLACE=$missing_place
  fi
  return 0
}

FIX_HINT=""

# fix_hint [slot]: sets FIX_HINT, the command or edit that changes the value just resolved.
fix_hint() {
  local slot=${1:-}
  case $RES_SOURCE in
    env)
      FIX_HINT="change or unset $RES_PLACE"
      ;;
    main)
      if [[ $RES_MAIN_SOURCE == env ]]; then
        FIX_HINT="change or unset DEVPIN_DESTINATION, or devpin use --slot $slot <device> for $slot alone"
      else
        FIX_HINT="devpin use <device> fixes both, devpin use --slot $slot <device> $slot alone"
      fi
      ;;
    local|default)
      if [[ -n $slot ]]; then
        FIX_HINT="devpin use --slot $slot <device>"
      else
        FIX_HINT="devpin use <device>"
      fi
      ;;
    *)
      FIX_HINT="write the device into .devpin/default, or run devpin use <device>"
      ;;
  esac
}

# ---------------------------------------------------------------- config

CFG_SLOTS=()
CFG_PACKAGES=()
CFG_IGNORE=()
CFG_REQUIRES=""

# version_ge <a> <b>: succeeds when version a >= version b, compared part by part as numbers;
# a missing part counts as 0.
version_ge() {
  local -a a b
  a=( ${(s:.:)1} ); b=( ${(s:.:)2} )
  local i n=$(( $#a > $#b ? $#a : $#b ))
  for (( i = 1; i <= n; i++ )); do
    (( 10#${a[i]:-0} > 10#${b[i]:-0} )) && return 0
    (( 10#${a[i]:-0} < 10#${b[i]:-0} )) && return 1
  done
  return 0
}

# load_config <root>: reads <root>/.devpin/config into CFG_SLOTS, CFG_PACKAGES, CFG_IGNORE and
# CFG_REQUIRES. A missing config is an empty one. Dies on the first parse error, except that a
# project requiring a newer devpin is reported as that, whatever else the file holds.
load_config() {
  local root=$1 file=$1/.devpin/config
  CFG_SLOTS=(); CFG_PACKAGES=(); CFG_IGNORE=(); CFG_REQUIRES=""
  [[ -f $file ]] || return 0

  local line word arg n=0 parse_err="" req_err=""
  while IFS= read -r line || [[ -n $line ]]; do
    (( n++ ))
    line=${line%%\#*}
    line=${line##[[:space:]]#}
    line=${line%%[[:space:]]#}
    [[ -n $line ]] || continue
    word=${line%%[[:space:]]*}
    arg=${line#"$word"}
    arg=${arg##[[:space:]]#}
    case $word in
      requires)
        if [[ -n $CFG_REQUIRES ]]; then
          [[ -n $parse_err ]] || parse_err="$n: requires given twice"
        elif [[ $arg != <->.<->(.<->|) ]]; then
          [[ -n $parse_err ]] || parse_err="$n: requires takes major.minor or major.minor.patch, not '$arg'"
        else
          CFG_REQUIRES=$arg
          if ! version_ge "$DEVPIN_VERSION" "$arg"; then
            req_err="$n: this project requires devpin $arg, this is $DEVPIN_VERSION — brew upgrade devpin"
          fi
        fi
        ;;
      slot)
        if [[ $arg =~ '^[a-z0-9-]+$' ]]; then
          CFG_SLOTS+=( "$arg" )
        else
          [[ -n $parse_err ]] || parse_err="$n: slot takes one name of a-z, 0-9 and -, not '$arg'"
        fi
        ;;
      packages|check-ignore)
        if [[ -z $arg ]]; then
          [[ -n $parse_err ]] || parse_err="$n: $word needs an argument"
        elif [[ $word == packages ]]; then
          CFG_PACKAGES+=( "$arg" )
        else
          CFG_IGNORE+=( "$arg" )
        fi
        ;;
      *)
        [[ -n $parse_err ]] || parse_err="$n: unknown entry '$word'"
        ;;
    esac
  done < "$file"

  [[ -z $req_err ]] || die "$file:$req_err"
  [[ -z $parse_err ]] || die "$file:$parse_err"
  return 0
}

KNOWN_SLOTS=()

# known_slots <repo>: sets KNOWN_SLOTS, the slots of the loaded config plus every slot that has a
# .local or .default file in <repo>/.devpin, sorted and unique.
known_slots() {
  local repo=$1 f name
  local -a all
  all=( "${CFG_SLOTS[@]}" )
  for f in "$repo"/.devpin/*.(local|default)(N); do
    name=${${f:t}%.*}
    [[ $name =~ '^[a-z0-9-]+$' ]] && all+=( "$name" )
  done
  KNOWN_SLOTS=( ${(ou)all} )
}

# check_slot <repo> <slot>: a malformed name is a wrong invocation; an unknown one is refused.
check_slot() {
  local repo=$1 slot=$2
  [[ $slot =~ '^[a-z0-9-]+$' ]] || usage
  known_slots "$repo"
  (( ${KNOWN_SLOTS[(Ie)$slot]} )) && return 0
  local list=none
  (( $#KNOWN_SLOTS )) && list=${(j:, :)KNOWN_SLOTS}
  die "unknown slot '$slot' — known: $list; declare it with 'slot $slot' in .devpin/config"
}

PKG_DIRS=()
PKG_SKIPPED=()

# collect_packages: sets PKG_DIRS (physical dirs holding Package.swift, in config order then glob
# order, unique, never ROOT) and PKG_SKIPPED (matched dirs without one). Patterns are relative to
# ROOT; a pattern matching nothing warns.
collect_packages() {
  PKG_DIRS=(); PKG_SKIPPED=()
  local pat dir
  local -a matches
  local -A seen
  for pat in "${CFG_PACKAGES[@]}"; do
    matches=( ${ROOT}/${~pat}(N/) )
    if (( $#matches == 0 )); then
      warn "packages $pat matches nothing"
      continue
    fi
    for dir in "${matches[@]}"; do
      dir=${dir:A}
      [[ $dir == "$ROOT" ]] && continue
      (( ${+seen[$dir]} )) && continue
      seen[$dir]=1
      if [[ -f $dir/Package.swift ]]; then
        PKG_DIRS+=( "$dir" )
      else
        PKG_SKIPPED+=( "$dir" )
      fi
    done
  done
}

# repo_label <dir>: prints the basename for ROOT, the path relative to ROOT for anything else.
repo_label() {
  local dir=$1
  if [[ $dir == "$ROOT" ]]; then
    print -r -- ${ROOT:t}
    return 0
  fi
  local -a a b rel
  a=( ${(s:/:)ROOT} ); b=( ${(s:/:)dir} )
  local i=1
  while (( i <= $#a && i <= $#b )) && [[ "${a[i]}" == "${b[i]}" ]]; do (( i++ )); done
  local up=$(( $#a - i + 1 ))
  while (( up-- > 0 )); do rel+=( .. ); done
  rel+=( "${(@)b[i,-1]}" )
  print -r -- ${(j:/:)rel}
}

# ---------------------------------------------------------------- device lists

SIMCTL_LIST=""
SIMCTL_STATE=""       # "" (not read yet) | loaded | unavailable
DEVICECTL_LIST=""
DEVICECTL_STATE=""
FOUND_NAME=""
FOUND_UNAVAILABLE=""  # "unavailable, <reason>" (or just "unavailable"), empty when usable

# destination_id <value>: prints the id= part of a destination (split on commas); returns 1 when
# there is none.
destination_id() {
  local part
  for part in "${(@s:,:)1}"; do
    if [[ $part == id=?* ]]; then
      print -r -- "${part#id=}"
      return 0
    fi
  done
  return 1
}

# load_simulators / load_devices: read a list once per process into *_LIST and *_STATE. Call them
# directly, never inside $( ... ): a subshell would lose what they loaded.
load_simulators() {
  [[ -z $SIMCTL_STATE ]] || return 0
  if SIMCTL_LIST=$(xcrun simctl list devices 2>/dev/null); then
    SIMCTL_STATE=loaded
  else
    SIMCTL_LIST=""; SIMCTL_STATE=unavailable
  fi
  return 0
}

load_devices() {
  [[ -z $DEVICECTL_STATE ]] || return 0
  if DEVICECTL_LIST=$(xcrun devicectl list devices --hide-headers --hide-default-columns --columns name --columns identifier --columns Reality --columns Platform 2>/dev/null); then
    DEVICECTL_STATE=loaded
  else
    DEVICECTL_LIST=""; DEVICECTL_STATE=unavailable
  fi
  return 0
}

# find_device <id>: succeeds when a simulator or a paired device answers to the id, setting
# FOUND_NAME and FOUND_UNAVAILABLE. devicectl is read only when simctl does not know the id.
find_device() {
  local id=$1 line rest mark
  FOUND_NAME=""; FOUND_UNAVAILABLE=""

  load_simulators
  if [[ $SIMCTL_STATE == loaded ]]; then
    for line in "${(@f)SIMCTL_LIST}"; do
      line=${line%%[[:space:]]#}
      [[ $line == *" ($id)"* ]] || continue
      FOUND_NAME=${line%%" ($id)"*}
      FOUND_NAME=${FOUND_NAME##[[:space:]]#}
      rest=${line#*" ($id)"}
      if [[ $rest == *"(unavailable"* ]]; then
        mark=${rest#*"(unavailable"}
        mark="unavailable$mark"
        FOUND_UNAVAILABLE=${mark%)}
      fi
      return 0
    done
  fi

  load_devices
  if [[ $DEVICECTL_STATE == loaded ]]; then
    for line in "${(@f)DEVICECTL_LIST}"; do
      line="$line "
      [[ $line == *" $id "* ]] || continue
      FOUND_NAME=${line%%" $id "*}
      FOUND_NAME=${FOUND_NAME%%[[:space:]]#}
      return 0
    done
  fi
  return 1
}

# unread_lists: prints which of the lists could not be read, for the warning; both loaders must
# have run (find_device failing guarantees it, unless simctl answered).
unread_lists() {
  if [[ $SIMCTL_STATE == unavailable && $DEVICECTL_STATE == unavailable ]]; then
    print -r -- "xcrun simctl and xcrun devicectl"
  elif [[ $SIMCTL_STATE == unavailable ]]; then
    print -r -- "xcrun simctl"
  elif [[ $DEVICECTL_STATE == unavailable ]]; then
    print -r -- "xcrun devicectl"
  fi
}

# ---------------------------------------------------------------- choices

SIM_ROWS=()          # "<id> <name>" per available iOS simulator, in simctl order
DEV_ROWS=()          # "<id> <name>" per paired physical iOS phone
CHOICES_STATE=""     # "" (not read yet) | loaded | failed
USE_VALUE=""

# load_choices: fills SIM_ROWS and DEV_ROWS. Returns 1 when `xcrun simctl list devices available`
# fails; a devicectl that cannot be read only leaves DEV_ROWS empty (DEVICECTL_STATE says so). Call
# it directly, never inside $( ... ).
load_choices() {
  [[ $CHOICES_STATE != loaded ]] || return 0
  [[ $CHOICES_STATE != failed ]] || return 1
  SIM_ROWS=(); DEV_ROWS=()

  local listing line header="" id name
  local sim_re='^[[:space:]]+(.*[^[:space:]]) \(([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})\) \([^()]*\)[[:space:]]*$'
  local dev_re='^(.*[^[:space:]])[[:space:]]{2,}([^[:space:]]+) \([^()]*\)[[:space:]]+physical[[:space:]]+iOS[[:space:]]*$'

  if ! listing=$(xcrun simctl list devices available 2>/dev/null); then
    CHOICES_STATE=failed
    return 1
  fi
  for line in "${(@f)listing}"; do
    if [[ $line == '-- '*' --' ]]; then
      header=$line
    elif [[ $header == '-- iOS '* && $line =~ $sim_re ]]; then
      name=${match[1]}; id=${match[2]}
      SIM_ROWS+=( "$id $name" )
    fi
  done

  load_devices
  if [[ $DEVICECTL_STATE == loaded ]]; then
    for line in "${(@f)DEVICECTL_LIST}"; do
      if [[ $line =~ $dev_re ]]; then
        name=${match[1]}; id=${match[2]}
        DEV_ROWS+=( "$id $name" )
      fi
    done
  fi
  CHOICES_STATE=loaded
  return 0
}

# resolve_device <arg>: sets USE_VALUE to the destination <arg> stands for. Returns 0, 1 (refused,
# the reason printed) or 2 (not a device at all: the caller calls usage).
resolve_device() {
  local arg=$1 part row
  USE_VALUE=""
  [[ -n $arg && $arg != booted && $arg != *$'\n'* ]] || return 2

  if [[ $arg == *platform=* ]]; then
    for part in "${(@s:,:)arg}"; do
      if [[ $part == platform=?* ]]; then
        USE_VALUE=$arg
        return 0
      fi
    done
    return 2
  fi

  if ! load_choices; then
    print -u2 -r -- "devpin: xcrun simctl list devices failed — cannot look up '$arg'; pass a platform= string to write it as is"
    return 1
  fi

  local -a found
  for row in "${SIM_ROWS[@]}"; do
    [[ ${(U)${row%% *}} == "${(U)arg}" ]] && { USE_VALUE="platform=iOS Simulator,id=${row%% *}"; return 0 }
  done
  for row in "${DEV_ROWS[@]}"; do
    [[ ${row%% *} == "$arg" ]] && { USE_VALUE="platform=iOS,id=${row%% *}"; return 0 }
  done

  for row in "${SIM_ROWS[@]}"; do
    [[ ${row#* } == "$arg" ]] && found+=( "platform=iOS Simulator,id=${row%% *}" )
  done
  for row in "${DEV_ROWS[@]}"; do
    [[ ${row#* } == "$arg" ]] && found+=( "platform=iOS,id=${row%% *}" )
  done

  if (( $#found == 1 )); then
    USE_VALUE=${found[1]}
    return 0
  elif (( $#found > 1 )); then
    print -u2 -r -- "devpin: '$arg' names $#found devices — pass one of them:"
    for part in "${found[@]}"; do print -u2 -r -- "  $part"; done
    return 1
  fi

  print -u2 -r -- "devpin: no available simulator or paired phone '$arg' — see devpin list"
  if [[ $DEVICECTL_STATE == unavailable ]]; then
    print -u2 -r -- "devpin: xcrun devicectl unavailable — paired phones were not searched"
  fi
  return 1
}

# write_atomic <dir> <file> <value>: writes <dir>/<file> through a temporary file beside it, then
# mv. The file gets the mode the user's umask allows (mktemp creates 0600). Returns 0 written,
# 1 failed. An interrupt removes the temporary file.
write_atomic() {
  local dir=$1 file=$2 value=$3 tmp rc=1
  tmp=$(mktemp "$dir/.$file.XXXXXX" 2>/dev/null) || return 1
  trap "rm -f -- ${(q)tmp}; exit 130" INT
  trap "rm -f -- ${(q)tmp}; exit 143" TERM
  trap "rm -f -- ${(q)tmp}" EXIT
  if printf '%s\n' "$value" > "$tmp" \
      && chmod "$(printf '%o' $(( 8#666 & ~8#$(umask) )))" "$tmp" \
      && mv -f -- "$tmp" "$dir/$file"; then
    rc=0
  else
    rm -f -- "$tmp"
  fi
  trap - INT TERM EXIT
  return $rc
}

# ---------------------------------------------------------------- commands

cmd_get() {
  local slot=""
  while (( $# > 0 )); do
    case $1 in
      --slot)
        (( $# >= 2 )) && [[ -n $2 ]] || usage
        slot=$2
        shift 2
        ;;
      *) usage ;;
    esac
  done
  find_root
  load_config "$ROOT"
  [[ -z $slot ]] || check_slot "$ROOT" "$slot"
  resolve "$ROOT" "$slot"
  if [[ $RES_SOURCE == missing ]]; then
    fix_hint "$slot"
    if [[ -n $slot ]]; then
      die "no destination for slot $slot of $ROOT: $(env_name "$slot") is unset, .devpin/$slot.local, .devpin/$slot.default, .devpin/local and .devpin/default hold no value — $FIX_HINT"
    fi
    die "no destination for $ROOT: DEVPIN_DESTINATION is unset and .devpin/local and .devpin/default hold no value — $FIX_HINT"
  fi

  local id reason hint
  if ! id=$(destination_id "$RES_VALUE"); then
    print -r -- "$RES_VALUE"
    return 0
  fi
  fix_hint "$slot"
  hint="$RES_VALUE comes from $RES_PLACE; $FIX_HINT (devpin list shows the devices)"
  if find_device "$id"; then
    if [[ -n $FOUND_UNAVAILABLE ]]; then
      reason=${FOUND_UNAVAILABLE#unavailable}
      reason=${reason#,}
      reason=${reason##[[:space:]]#}
      [[ -n $reason ]] || reason="no reason given"
      die "simulator $FOUND_NAME with id $id is unavailable ($reason) — $hint"
    fi
  elif [[ -n $(unread_lists) ]]; then
    warn "id $id was not found, but $(unread_lists) could not be read — the id was not checked"
  else
    die "no simulator or paired device with id $id on this machine — $hint"
  fi
  print -r -- "$RES_VALUE"
}
DESCRIBED=""

# describe <value>: sets DESCRIBED to the value plus what the device lists say about its id=. Call
# it directly, never inside $( ... ): it may load the lists.
describe() {
  local value=$1 id
  DESCRIBED=$value
  id=$(destination_id "$value") || return 0
  if find_device "$id"; then
    DESCRIBED="$value ($FOUND_NAME)"
    if [[ -n $FOUND_UNAVAILABLE ]]; then
      DESCRIBED="$DESCRIBED ($FOUND_UNAVAILABLE)"
    fi
  elif [[ $SIMCTL_STATE == unavailable && $DEVICECTL_STATE == unavailable ]]; then
    DESCRIBED="$value (simctl and devicectl unavailable)"
  elif [[ $DEVICECTL_STATE == unavailable ]]; then
    DESCRIBED="$value (unknown to simctl, devicectl unavailable)"
  elif [[ $SIMCTL_STATE == unavailable ]]; then
    DESCRIBED="$value (unknown to devicectl, simctl unavailable)"
  else
    DESCRIBED="$value (unknown id)"
  fi
  return 0
}

# show_repo <dir>: the rows of one repository, one per slot (main first).
show_repo() {
  local dir=$1 label slot
  label=$(repo_label "$dir")
  known_slots "$dir"
  for slot in "" "${KNOWN_SLOTS[@]}"; do
    resolve "$dir" "$slot"
    if [[ $RES_SOURCE == missing ]]; then
      printf '%-24s %-10s %-8s %s\n' "$label" "${slot:-main}" missing -
    else
      describe "$RES_VALUE"
      printf '%-24s %-10s %-8s %s\n' "$label" "${slot:-main}" "$RES_SOURCE" "$DESCRIBED"
    fi
  done
}

cmd_show() {
  (( $# == 0 )) || usage
  find_root
  load_config "$ROOT"
  collect_packages

  local dir
  show_repo "$ROOT"
  for dir in "${PKG_DIRS[@]}"; do
    if [[ -d $dir/.devpin ]]; then
      show_repo "$dir"
    else
      printf '%-24s %s\n' "$(repo_label "$dir")" "(no .devpin/)"
    fi
  done
  for dir in "${PKG_SKIPPED[@]}"; do
    printf '%-24s %s\n' "$(repo_label "$dir")" "(no Package.swift — skipped)"
  done
  return 0
}

cmd_list() {
  (( $# == 0 )) || usage
  load_choices || die "xcrun simctl list devices failed — simulators cannot be listed"

  local row
  print -r -- "Simulators:"
  (( $#SIM_ROWS )) || print -r -- "  (none)"
  for row in "${SIM_ROWS[@]}"; do
    printf '  %-36s %s\n' "${row#* }" "${row%% *}"
  done

  if [[ $DEVICECTL_STATE == unavailable ]]; then
    warn "xcrun devicectl unavailable — paired phones are not listed"
    return 0
  fi
  print -r -- "Devices:"
  (( $#DEV_ROWS )) || print -r -- "  (none)"
  for row in "${DEV_ROWS[@]}"; do
    printf '  %-36s %s\n' "${row#* }" "${row%% *}"
  done
  return 0
}

# cmd_use [--slot S] [--only-root] (<device> | --reset): writes (or removes) .devpin/[S.]local in
# the root and in every package. Arguments are validated, and the device resolved and refused,
# before anything is written.
cmd_use() {
  local slot="" only_root=0 reset=0 device="" have_device=0
  while (( $# > 0 )); do
    case $1 in
      --slot)
        (( $# >= 2 )) && [[ $2 =~ '^[a-z0-9-]+$' ]] || usage
        slot=$2
        shift 2
        ;;
      --only-root) only_root=1; shift ;;
      --reset)     reset=1; shift ;;
      --*)         usage ;;
      *)
        (( have_device )) && usage
        device=$1; have_device=1
        shift
        ;;
    esac
  done
  if (( reset )); then
    (( have_device )) && usage
  else
    (( have_device )) || usage
  fi

  local rc=0
  if (( ! reset )); then
    resolve_device "$device" || rc=$?
    (( rc != 2 )) || usage
    (( rc == 0 )) || exit 1
  fi

  find_root
  load_config "$ROOT"
  [[ -z $slot ]] || check_slot "$ROOT" "$slot"

  local file=local
  [[ -z $slot ]] || file="$slot.local"
  local -a repos=( "$ROOT" )
  if (( ! only_root )); then
    collect_packages
    repos+=( "${PKG_DIRS[@]}" )
  fi

  if (( reset )); then
    print -r -- ".devpin/$file removed:"
  else
    describe "$USE_VALUE"
    print -r -- ".devpin/$file <- $DESCRIBED:"
  fi

  local repo outcome failed=0
  for repo in "${repos[@]}"; do
    if (( reset )); then
      if [[ ! -e $repo/.devpin/$file ]]; then
        outcome=absent
      elif rm -f -- "$repo/.devpin/$file"; then
        outcome=removed
      else
        outcome="FAILED to remove"; (( failed++ ))
      fi
    else
      if mkdir -p -- "$repo/.devpin" 2>/dev/null && write_atomic "$repo/.devpin" "$file" "$USE_VALUE"; then
        outcome=written
        if ! git -C "$repo" check-ignore -q ".devpin/$file" 2>/dev/null; then
          outcome="written, WARNING: git does not ignore .devpin/$file here — add .devpin/*local to .gitignore"
        fi
      else
        outcome="FAILED to write"; (( failed++ ))
      fi
    fi
    printf '  %-28s %s\n' "$(repo_label "$repo")" "$outcome"
  done

  if (( failed )); then
    print -u2 -r -- "devpin: $failed repositories not updated"
    return 1
  fi
  return 0
}
cmd_init()  { die "init: not implemented" }
cmd_check() { die "check: not implemented" }

# ---------------------------------------------------------------- dispatcher

main() {
  while (( $# > 0 )); do
    case $1 in
      --root)
        (( $# >= 2 )) || usage
        ROOT_OPT=$2
        shift 2
        ;;
      *) break ;;
    esac
  done

  (( $# > 0 )) || usage
  local cmd=$1
  shift
  case $cmd in
    get)     cmd_get "$@" ;;
    show)    cmd_show "$@" ;;
    list)    cmd_list "$@" ;;
    use)     cmd_use "$@" ;;
    init)    cmd_init "$@" ;;
    check)   cmd_check "$@" ;;
    --version) print -r -- "$DEVPIN_VERSION" ;;
    -h|--help) usage_text ;;
    *) usage ;;
  esac
}

main "$@"
